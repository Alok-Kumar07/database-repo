<% layout("/layouts/boilerplate") %>

<div class="admin-page">
    <div class="admin-header">
        <div>
            <h1 class="admin-page-title"><i class="fa-solid fa-shield-halved me-2" style="color:var(--admin-gold);"></i>Admin Dashboard</h1>
            <p class="admin-subtitle">Manage all listings — verify, view, and delete</p>
        </div>
        <a href="/listings" class="btn-primary-wander"><i class="fa-solid fa-arrow-left me-1"></i> Back to Listings</a>
    </div>

    <!-- Stats -->
    <div class="admin-stats">
        <div class="stat-card stat-total">
            <div class="stat-number"><%= allListings.length %></div>
            <div class="stat-label">Total Listings</div>
        </div>
        <div class="stat-card stat-verified">
            <div class="stat-number"><%= verifiedCount %></div>
            <div class="stat-label">Verified</div>
        </div>
        <div class="stat-card stat-pending">
            <div class="stat-number"><%= pendingCount %></div>
            <div class="stat-label">Pending Verification</div>
        </div>
    </div>

    <!-- Table -->
    <div class="admin-table-wrap">
        <div class="admin-table-header">
            <span class="admin-table-title">All Listings</span>
        </div>
        <div style="overflow-x:auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Location</th>
                        <th>Owner</th>
                        <th>Price/night</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(let listing of allListings) { %>
                        <tr>
                            <td>
                                <img src="<%= listing.image.url %>" class="table-listing-img" alt="">
                            </td>
                            <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500;">
                                <%= listing.title %>
                            </td>
                            <td><%= listing.location %>, <%= listing.country %></td>
                            <td>
                                <% if(listing.owner) { %>
                                    <span style="display:flex;align-items:center;gap:6px;">
                                        <div style="width:22px;height:22px;background:var(--dark);color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.68rem;font-weight:600;flex-shrink:0;">
                                            <%= listing.owner.username.charAt(0).toUpperCase() %>
                                        </div>
                                        <%= listing.owner.username %>
                                    </span>
                                <% } else { %>
                                    <span style="color:var(--text-muted);">—</span>
                                <% } %>
                            </td>
                            <td>₹<%= listing.price.toLocaleString("en-IN") %></td>
                            <td>
                                <% if(listing.isVerified) { %>
                                    <span class="status-badge status-verified"><i class="fa-solid fa-circle-check"></i> Verified</span>
                                <% } else { %>
                                    <span class="status-badge status-pending"><i class="fa-solid fa-clock"></i> Pending</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a href="/listings/<%= listing._id %>" class="table-btn table-btn-view">
                                        <i class="fa-solid fa-eye"></i> View
                                    </a>
                                    <% if(!listing.isVerified) { %>
                                        <form method="POST" action="/listings/<%= listing._id %>/verify" style="margin:0;">
                                            <button class="table-btn table-btn-verify" type="submit">
                                                <i class="fa-solid fa-circle-check"></i> Verify
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <form method="POST" action="/listings/<%= listing._id %>/unverify" style="margin:0;">
                                            <button class="table-btn table-btn-unverify" type="submit">
                                                <i class="fa-solid fa-circle-xmark"></i> Unverify
                                            </button>
                                        </form>
                                    <% } %>
                                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" style="margin:0;" onsubmit="return confirm('Delete this listing?')">
                                        <button class="table-btn table-btn-delete" type="submit">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                    <% if(allListings.length === 0) { %>
                        <tr>
                            <td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted);">
                                No listings found
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
